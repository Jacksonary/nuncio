{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuncio",
  "version": "0.1.0",
  "identifier": "app.nuncio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nuncio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica",
            "sidebar"
          ]
        },
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost nuncio: http://nuncio.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' about: blob: data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob: data:; font-src 'self' data:",
      "assetProtocol": {
        "enable": false
      },
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost nuncio: http://nuncio.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' about: blob: data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*; media-src 'self' blob: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Lightweight mail, calendar, contacts and to-do",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "eml"
        ],
        "name": "Email Message",
        "mimeType": "message/rfc822",
        "role": "Viewer"
      },
      {
        "ext": [
          "ics"
        ],
        "name": "iCalendar",
        "mimeType": "text/calendar",
        "role": "Viewer"
      },
      {
        "ext": [
          "vcf"
        ],
        "name": "vCard",
        "mimeType": "text/vcard",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto",
          "webcal",
          "webcals",
          "nuncio"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMTIwQkJDNjI3MkZBOEQKUldTTituSml2QXNTc1hjWW1kSHBzQTBSSGVaZk1CWThYeGd3QlVuT3FaVnlFQnlCTHZXL29JU1cK",
      "endpoints": [
        "https://github.com/Jacksonary/nuncio/releases/latest/download/latest.json",
        "https://gitee.com/weiguoliu/nuncio/releases/latest/download/latest.json"
      ]
    }
  }
}
